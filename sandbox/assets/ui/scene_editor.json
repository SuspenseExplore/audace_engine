{
	"name": "Scene Editor",
	"type": "window",
	"platform_props": {
		"glfw": {
			"position": [100, 100],
			"size": [900, 300]
		},
		"oxr": {
			"position": [400, 400],
			"size": [800, 500]
		}
	},
	"children": [
		{
			"name": "scene_tabs",
			"type": "tab_bar",
			"tab_items": [
				{
					"name": "Scene",
					"children": [
						{
							"name": "Clear Color",
							"type": "drag_float4",
							"speed": 0.01,
							"min": 0,
							"max": 1
						},
						{
							"name": "Ambient Color",
							"type": "drag_float4",
							"speed": 0.01,
							"min": 0,
							"max": 1
						}
					]
				},
				{
					"name": "Graph",
					"children": [
						{
							"name": "Visualize",
							"type": "checkbox"
						},
						{
							"type": "same_line"
						},
						{
							"name": "Reload Scene",
							"type": "button"
						},
						{
							"type": "separator"
						},
						{
							"name": "scene_graph",
							"type": "tree",
							"tree_node": {
								"name": "scene_graph_node",
								"type": "tree_node",
								"children": [
									{
										"type": "same_line",
										"x_offset": 500
									},
									{
										"name": "Select",
										"type": "button",
										"param": "scene_graph_node"
									},
									{
										"type": "same_line"
									},
									{
										"name": "New Child",
										"type": "button",
										"param": "scene_graph_node"
									},
									{
										"type": "same_line"
									},
									{
										"name": "Add Cube",
										"type": "button",
										"param": "scene_graph_node"
									}
								]
							}
						}
					]
				},
				{
					"name": "Post Proc",
					"children": [
						{
							"name": "Kernel",
							"type": "text"
						},
						{
							"name": "kernel 0, 1, 2",
							"type": "input_float3"
						},
						{
							"name": "kernel 3, 4, 5",
							"type": "input_float3"
						},
						{
							"name": "kernel 6, 7, 8",
							"type": "input_float3"
						},
						{
							"name": "Preset",
							"type": "combo_simple",
							"values": [
								"Normal",
								"Sharpen",
								"Blur",
								"Edge Detect"
							]
						},
						{
							"name": "Offset Scale",
							"type": "drag_float",
							"min": 0.00001,
							"max": 10,
							"speed": 0.001
						},
						{
							"name": "Apply",
							"type": "button"
						}
					]
				}
			]
		}
	]
}